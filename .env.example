# ==========================================================
# TSJH PORTALS — environment
# Copy to .env.local for development. Set the same keys in your
# host's dashboard for production.
#
# The app RUNS with none of these set. What you lose without them
# is written against each block — nothing fails silently.
# ==========================================================

# ---------- 0. YOUR DOMAIN ----------
# The canonical origin. Drives the sitemap, robots.txt, canonical tags
# and every share preview. No trailing slash.
#   NEXT_PUBLIC_SITE_URL=https://tnwla-madras.com
# Leave it unset on preview deployments — Vercel's own URL is used.
NEXT_PUBLIC_SITE_URL=

# ---------- 1. SESSIONS (set this before going live) ----------
# Signs the Superadmin cookie. Any long random string.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Unset: a built-in development fallback is used, so anyone who reads
# this repository can mint a valid admin session. Set it.
SESSION_SECRET=

# ---------- 2. SUPERADMIN ----------
# Defaults to "Master - TSJH" / "Enterprises@2026" so the portal works
# on first run. Those defaults are in the source, therefore public,
# therefore not secrets — change them before the site is reachable.
#   npm run hash-password -- "your new password"
SUPERADMIN_USER=Master - TSJH
SUPERADMIN_PASSWORD_HASH=

# ---------- 3. STORAGE ----------
# Where orders, enquiries and content overrides live.
#
# Unset: a JSON file at .data/db.json. Fine for development and for
# any host with a real disk (a VPS, Render with a persistent disk).
# On Vercel the filesystem is read-only and discarded between
# requests, so WITHOUT THESE KEYS EVERY ORDER IS LOST. Create a KV /
# Upstash Redis store and paste its REST credentials here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- 4. PAYMENTS ----------
# Razorpay. Unset: the site falls back to the UPI hand-off — the
# customer pays, types a reference, and the order waits at
# "awaiting verification" until someone clears it in Superadmin
# against the bank statement. That is a working manual process, not a
# broken one, so add these when you are ready and not before.
# The secret is used only on the server and never reaches the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- 5. AI (Grok) ----------
# Powers the chatbot on all four brands and the weekly blog draft.
# Get a key at console.x.ai. WITHOUT IT nothing breaks: the chatbots
# fall back to the keyword answers they have always used, and the blog
# job reports that it was skipped.
GROK_API_KEY=
# Optional — defaults to grok-3.
GROK_MODEL=

# ---------- 6. SCHEDULED JOBS ----------
# Any long random string. Vercel Cron sends it as a bearer token to
# /api/news/refresh (hourly) and /api/blog/generate (Mondays 04:00).
# Until it is set, those endpoints refuse cron callers outright — a job
# that stops running is noticed; an open endpoint that does real work
# on every request is not.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ---------- 7. IMAGE UPLOADS ----------
# Superadmin > Appearance can upload logos and background images.
# Create a Blob store in the Vercel dashboard (about a minute) and
# paste its token. Without it the colour, font and size controls still
# work and only the image picker is disabled, with a line saying why.
BLOB_READ_WRITE_TOKEN=
